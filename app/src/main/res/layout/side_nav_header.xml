<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="230dp"
    android:orientation="vertical"
    android:gravity="bottom"
    android:padding="20dp"
    android:background="@color/md_theme_primaryContainer">

    <TextView
        android:id="@+id/headerWelcomeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome back"
        android:textColor="@color/md_theme_onPrimaryContainer"
        android:textSize="13sp"
        android:alpha="0.85" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="82dp"
        android:layout_height="82dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="14dp"
        app:cardCornerRadius="41dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/md_theme_outlineVariant"
        app:strokeWidth="1dp">
        <ImageView
            android:id="@+id/headerAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Profile image"
            android:src="@drawable/account_circle_24px" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/headerName"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ButterQueen User"
        android:textColor="@color/md_theme_onPrimaryContainer"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/headerEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="user@email.com"
        android:textColor="@color/md_theme_onPrimaryContainer"
        android:textSize="14sp"
        android:alpha="0.90" />

    <TextView
        android:id="@+id/headerMemberText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Sweet Moments Member"
        android:textColor="@color/md_theme_onPrimaryContainer"
        android:textSize="12sp"
        android:alpha="0.75" />

</LinearLayout>