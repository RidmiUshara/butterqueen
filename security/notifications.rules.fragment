// Add these blocks INSIDE the existing match /users/{uid} {...} section
// in Firebase Console -> Firestore Database -> Rules. Do NOT replace your
// existing rules. Publish after merging and test the rules.

// Inbox documents are written only by trusted Cloud Functions (Admin SDK).
match /notifications/{notificationId} {
  allow get, list: if isOwner(uid);
  allow create, delete: if false;
  allow update: if isOwner(uid)
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
    && request.resource.data.read == true;
}

// Authenticated users register or revoke their own device's FCM token.
// Admin SDK can read/write regardless of these client rules.
match /pushTokens/{installationId} {
  allow get, list: if isOwner(uid);
  allow create, update: if isOwner(uid)
    && request.resource.data.keys().hasOnly(['token','platform','updatedAtMillis'])
    && request.resource.data.keys().hasAll(['token','platform','updatedAtMillis'])
    && request.resource.data.token is string
    && request.resource.data.token.size() > 20
    && request.resource.data.token.size() < 4096
    && request.resource.data.platform == 'android'
    && request.resource.data.updatedAtMillis is int;
  allow delete: if isOwner(uid);
}
