rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.get('role', '') == 'admin';
    }
    function ownsOrderAfterBatch(orderId) {
      return signedIn()
        && !exists(/databases/$(database)/documents/orders/$(orderId))
        && getAfter(/databases/$(database)/documents/orders/$(orderId))
             .data.userId == request.auth.uid;
    }
    function ownsOrder(orderId) {
      return signedIn()
        && exists(/databases/$(database)/documents/orders/$(orderId))
        && get(/databases/$(database)/documents/orders/$(orderId))
             .data.userId == request.auth.uid;
    }

    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      // A customer cannot give their own profile an admin role.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'id', 'firstName', 'lastName', 'email', 'birthday',
          'phone', 'address', 'profileImageUrl', 'createdAtMillis'
        ])
        && request.resource.data.keys().hasAll([
          'id', 'firstName', 'lastName', 'email', 'birthday',
          'phone', 'address', 'profileImageUrl', 'createdAtMillis'
        ])
        && request.resource.data.id == uid
        && request.resource.data.email == request.auth.token.email;
      allow update: if isAdmin() || (
        isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firstName', 'lastName', 'birthday', 'phone',
          'address', 'profileImageUrl'
        ])
      );
      allow delete: if isAdmin();

      match /cart/{cartId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'orderId', 'userId', 'customerName', 'customerPhone',
          'deliveryAddress', 'note', 'subtotalAmount', 'deliveryFee',
          'totalAmount', 'totalItems', 'paymentMethod', 'paymentReference',
          'paymentStatus', 'orderStatus', 'createdAtMillis'
        ])
        && request.resource.data.keys().hasAll([
          'orderId', 'userId', 'paymentMethod', 'paymentStatus', 'orderStatus'
        ])
        && request.resource.data.orderId == orderId
        && request.resource.data.userId == request.auth.uid
        && (
          (request.resource.data.paymentMethod == 'cash_on_delivery'
            && request.resource.data.paymentStatus == 'pending'
            && request.resource.data.orderStatus == 'placed')
          ||
          (request.resource.data.paymentMethod == 'payhere'
            && request.resource.data.paymentStatus == 'verification_pending'
            && request.resource.data.orderStatus == 'payment_pending')
        );
      // A client admin may manage order status, but cannot declare a payment paid.
      allow update: if isAdmin()
        && request.resource.data.orderStatus in [
          'placed', 'preparing', 'out_for_delivery', 'delivered',
          'cancelled', 'payment_pending'
        ]
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['orderStatus'])
        && (resource.data.paymentMethod != 'payhere'
          || resource.data.paymentStatus == 'paid'
          || request.resource.data.orderStatus in ['payment_pending', 'cancelled']);
      allow delete: if false;

      match /items/{itemId} {
        allow get, list: if isAdmin() || ownsOrder(orderId);
        allow create: if ownsOrderAfterBatch(orderId)
          && request.resource.data.keys().hasOnly([
            'orderItemId', 'productId', 'productName', 'productImageUrl',
            'unitPrice', 'quantity', 'unitType', 'selectedSize',
            'selectedFlavor', 'cakeMessage', 'itemTotal'
          ])
          && request.resource.data.orderItemId == itemId;
        allow update, delete: if false;
      }
    }

    // This collection is not used by this Android repo. Define its schema
    // and allowed initial status before enabling customer writes.
    match /surpriseDeliveries/{deliveryId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
